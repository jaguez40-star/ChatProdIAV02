# ══════════════════════════════════════════════════════════════════════════════
# Copiar este archivo a .env y completar los valores reales.
# Los nombres de variable deben coincidir exactamente con src/core/config.py.
# NUNCA versionar el .env real — está bloqueado en .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────────────────
# "development" → cookie Secure=False | "production" → cookie Secure=True
APP_ENV=development
APP_PORT=6034
LOG_LEVEL=INFO

# ── Base de datos de autenticación (SQLite, motor db_auth — CRÍTICA) ───────────
DATABASE_URL=sqlite:///./data/prodia_v02_auth.db

# ── Base de datos operacional (PostgreSQL, motor db_prod) ─────────────────────
# Sin esta variable (o con Postgres apagado) el backend arranca igual y
# /health reporta "degraded". Crítica desde F1: `tablas` y `analisis`
# responden 503, pero el login y el resto de la app siguen funcionando (H9).
#
# DOS ENTORNOS — mantener activo UNO y comentar el otro:
#
#   LOCAL: obligatorio para desarrollar F3 (Ingesta). F3 ESCRIBE en esta BD y
#   un bug en un DELETE/UPSERT no devuelve datos equivocados: los corrompe.
#   NUNCA se desarrolla F3 contra el 139.
PROD_DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/daily_report_prod
#
#   139 (requiere VPN): para LEER datos reales con F1/F2 y verificar R3.
#   Al terminar, volver a la local antes de tocar F3.
# PROD_DATABASE_URL=postgresql+psycopg2://usuario:password@10.100.26.139:5432/daily_report_prod?sslmode=disable

# ── Seguridad — cookie firmada (itsdangerous) ───────────────────────────────────
# Mínimo 32 caracteres. Cambiar en producción.
SECRET_KEY=change-me-to-a-random-32-char-string-in-production

# ── LDAP / Active Directory ────────────────────────────────────────────────────
AUTH_AD_DOMAIN=red.ecopetrol.com.co
# Dejar vacío para auto-discovery vía DNS SRV (dnspython). Completar solo si
# el servidor LDAP tiene IP fija o el DNS SRV no responde.
AUTH_AD_SERVER=
AUTH_AD_TIMEOUT_SEC=10

# ── Sesión ──────────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30

# ── Login local de desarrollo auditado (D3) ─────────────────────────────────────
# Desactivado por defecto. NO activar en producción.
# ⚠️ LOCAL_LOGIN_ALLOWED_IPS NUNCA admite "*" — el backend no arranca si lo lleva.
ENABLE_LOCAL_LOGIN=false
LOCAL_LOGIN_USERNAME=
LOCAL_LOGIN_PASSWORD=
# Credenciales adicionales (se suman, no reemplazan): "user1:pass1,user2:pass2"
LOCAL_LOGIN_EXTRA_USERS=
LOCAL_LOGIN_ALLOWED_IPS=127.0.0.1,::1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Solo hace falta cuando el frontend vive en OTRO origen — es decir, en
# desarrollo, donde Vite sirve en :6033 y el backend en :6034.
# Con SERVE_STATIC=true (producción) ambos comparten origen y CORS deja de
# intervenir: no hay nada que configurar.
CORS_ORIGINS=http://localhost:6033

# ── F6 · Servir el frontend compilado (B-4) ─────────────────────────────────
# false en DESARROLLO: el proxy `/api` del dev server de Vite resuelve todo.
#
# true en PRODUCCIÓN: el backend sirve `prodia_v02_frontend/dist/` y toda la
# aplicación vive en UN puerto (6034). Es lo que hace desplegable el frontend:
# `apiClient` usa `baseUrl: '/'` (relativo), así que solo alcanza al backend si
# comparten origen.
#
# Antes de arrancar con true hay que compilar:  pnpm build
# Si falta el `dist/`, el backend arranca igual y lo avisa en el log — nunca
# revienta por esto.
SERVE_STATIC=false
# Relativa a prodia_v02_backend/ si no es absoluta.
STATIC_DIR=../prodia_v02_frontend/dist

# ── Seed del padrón (D2, migración 0003_seed_padron) ────────────────────────────
# Ruta a robustez_v02_auth.db — se abre SOLO LECTURA, nunca se modifica.
# Se importan ÚNICAMENTE username/email/full_name; nada de permisos ni bitácora.
SEED_SOURCE_AUTH_DB=C:/APLICACIONES/Robustez/Des_robustez_2.0/robustez_v02_backend/data/robustez_v02_auth.db
# CSV de usernames que entran como administradores de ProdIA V02.
# OBLIGATORIO — sin al menos uno, la migración 0003 aborta (nunca deja un
# padrón sin ningún admin).
SEED_ADMIN_USERNAMES=javier.guerrero

# ── F2 · Fuentes de datos de Análisis ───────────────────────────────────────
# Ficheros operativos, FUERA del repo: se copian al desplegar. Si faltan, la
# feature degrada con `sin_datos` + motivo (HTTP 200), nunca un 500.
# ECP_DIFERIDAS.db se abre en SOLO LECTURA (sus índices están dañados; la tabla
# de datos AVM_DATADIF está sana — ver comentario en core/config.py).
DIFERIDAS_DB_PATH=./data/ECP_DIFERIDAS.db
EVENTOS_OW_PATH=./data/Eventos_OW.xlsx

# ── F2 · BD operacional ROBUSTEZ (schema ops) — EBITDA ──────────────────────
# Vacío = /ebitda responde 503 con mensaje claro; el resto de la app no se ve
# afectada. Sin ella NO se puede comprobar el ancla Castilla = 78.629 kUSD.
#
# Vive en la MISMA máquina que daily_report_prod, base `robustez_v02`, usuario
# `robustez`. Valores reales en `INGESTA/Rep_Prod/.env` del sistema de origen.
#
# ⚠️ La contraseña de `robustez` contiene el carácter `£`, que DEBE ir
# URL-encodeado como %C2%A3 o SQLAlchemy falla al autenticar.
OPS_DATABASE_URL=
# OPS_DATABASE_URL=postgresql+psycopg2://robustez:clave%C2%A3aqui@10.100.26.139:5432/robustez_v02?sslmode=disable

# ── F2 · LLM (Ollama) ───────────────────────────────────────────────────────
# Dev: qwen2.5:3b local. Prod/139: gemma4:latest (apuntar la URL a esa IP).
CONSULTA_OLLAMA_URL=http://localhost:11434/api/generate
CONSULTA_LLM_MODEL=qwen2.5:3b
# "-1" = el modelo queda residente indefinidamente (evita el arranque en frío).
CONSULTA_KEEP_ALIVE=-1

# ── F2 · Análisis Ejecutivo ─────────────────────────────────────────────────
# false en dev: el composer determinista supera al qwen local, que confunde
# cifras. true en prod con gemma4 para el pulido de prosa.
EJECUTIVO_USAR_LLM=false
# false SOLO en pruebas: no tapa un fallo del LLM con el texto base.
EJECUTIVO_FALLBACK=true
# Banda ámbar de las tarjetas de cierre (0.93 = ajustado desde el 93% de meta).
KPI_CIERRE_AMBAR_PCT=0.93
# TTL de la caché de los paneles caros, en segundos (900 = 15 min).
ANALISIS_CACHE_TTL_S=900

# ── F3 · Ingesta de archivos .xlsm ─────────────────────────────────────────
# Dónde aterrizan los archivos subidos. Se conservan tras ingerir: son la única
# evidencia de qué se cargó si hay que auditar un reporte. Vive FUERA del repo.
INGESTA_UPLOAD_DIR=./data/uploads
# Tope de tamaño en MB. Los .xlsm NEW reales rondan los 125 MB.
INGESTA_MAX_UPLOAD_MB=200
# Latido del progreso en vivo, en segundos. Sin él, una hoja pesada puede pasar
# minutos sin emitir nada y un proxy cortaría la conexión a mitad de la ingesta.
INGESTA_SSE_HEARTBEAT_S=15
