# ══════════════════════════════════════════════════════════════════════════════
# Copiar este archivo a .env y completar los valores reales.
# Los nombres de variable deben coincidir exactamente con src/core/config.py.
# NUNCA versionar el .env real — está bloqueado en .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────────────────
# "development" → cookie Secure=False | "production" → cookie Secure=True
APP_ENV=development
APP_PORT=6034
LOG_LEVEL=INFO

# ── Base de datos de autenticación (SQLite, motor db_auth — CRÍTICA) ───────────
DATABASE_URL=sqlite:///./data/prodia_v02_auth.db

# ── Base de datos operacional (PostgreSQL, motor db_prod — OPCIONAL en F0) ─────
# Sin esta variable (o con Postgres apagado) el backend arranca igual y
# /health reporta "degraded". Pasa a crítica en F1.
# DESARROLLO — PostgreSQL LOCAL (decisión DA-1 del plan F3).
# F3 ESCRIBE en esta BD: un bug en un DELETE o un UPSERT no devuelve datos
# equivocados, los corrompe. Por eso se desarrolla contra local y NUNCA contra
# el 139 de producción. La BD local tiene el esquema completo (bronze.* + core.*)
# y se llena ingiriendo un .xlsm real.
# PROD_DATABASE_URL=postgresql+psycopg2://robustez:69-xMc8oTg%C2%A35@localhost:5432/daily_report_prod?sslmode=disable

# PRODUCCIÓN — servidor 139 (requiere VPN). Comentado a propósito mientras se
# desarrolla F3. Descomentar solo para leer datos reales con F1/F2.
PROD_DATABASE_URL=postgresql+psycopg2://postgres:y~87z0%3F%3ERi6w@10.100.26.139:5432/daily_report_prod?sslmode=disable

# BD operacional de ROBUSTEZ (schema ops.*) — se usa desde F2 (EBITDA)
OPS_DATABASE_URL=postgresql+psycopg2://robustez:69-xMc8oTg%C2%A35@10.100.26.139:5432/robustez_v02?sslmode=disable

# ── Seguridad — cookie firmada (itsdangerous) ───────────────────────────────────
# Mínimo 32 caracteres. Cambiar en producción.
SECRET_KEY=IwcdAC9ebNz6ZzreHLSC_kRpdt4eLF5NIX76kF9-WN8

# ── LDAP / Active Directory ────────────────────────────────────────────────────
AUTH_AD_DOMAIN=red.ecopetrol.com.co
# Dejar vacío para auto-discovery vía DNS SRV (dnspython). Completar solo si
# el servidor LDAP tiene IP fija o el DNS SRV no responde.
AUTH_AD_SERVER=
AUTH_AD_TIMEOUT_SEC=10

# ── Sesión ──────────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30

# ── Login local de desarrollo auditado (D3) ─────────────────────────────────────
# Desactivado por defecto. NO activar en producción.
# ⚠️ LOCAL_LOGIN_ALLOWED_IPS NUNCA admite "*" — el backend no arranca si lo lleva.
ENABLE_LOCAL_LOGIN=true
LOCAL_LOGIN_USERNAME=admin
LOCAL_LOGIN_PASSWORD=admin123
# Credenciales adicionales (se suman, no reemplazan): "user1:pass1,user2:pass2"
LOCAL_LOGIN_EXTRA_USERS=
LOCAL_LOGIN_ALLOWED_IPS=127.0.0.1,::1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:6033

# ── Seed del padrón (D2, migración 0003_seed_padron) ────────────────────────────
# Ruta a robustez_v02_auth.db — se abre SOLO LECTURA, nunca se modifica.
# Se importan ÚNICAMENTE username/email/full_name; nada de permisos ni bitácora.
SEED_SOURCE_AUTH_DB=C:/APLICACIONES/Robustez/Des_robustez_2.0/robustez_v02_backend/data/robustez_v02_auth.db
# CSV de usernames que entran como administradores de ProdIA V02.
# OBLIGATORIO — sin al menos uno, la migración 0003 aborta (nunca deja un
# padrón sin ningún admin).
SEED_ADMIN_USERNAMES=javier.guerrero

# ── F2 · Fuentes de datos de Análisis (copiadas del proyecto padre) ─────────
DIFERIDAS_DB_PATH=./data/ECP_DIFERIDAS.db
EVENTOS_OW_PATH=./data/Eventos_OW.xlsx

# ── F2 · LLM y Análisis Ejecutivo (dev: composer determinista) ──────────────
CONSULTA_OLLAMA_URL=http://localhost:11434/api/generate
CONSULTA_LLM_MODEL=qwen2.5:3b
CONSULTA_KEEP_ALIVE=-1
EJECUTIVO_USAR_LLM=false
EJECUTIVO_FALLBACK=true
KPI_CIERRE_AMBAR_PCT=0.93
ANALISIS_CACHE_TTL_S=900
